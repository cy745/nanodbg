+/* 自动启动：/Apps/Startup/autolaunch 里写一个应用名（CFBundleName），
+ * 首次主屏 dispatch 后启动延时计时器，用于无人值守的迭代测试。
+ *   -2 = 尚未解析， -1 = 无， >=0 = 待启动的 g_launch 槽位 */
+#define AUTOLAUNCH_PATH "/Apps/Startup/autolaunch"
+static int             s_auto_slot = -2;
+
 static void hb_app_executable_path(char path[64], const hb_app_launch_t *L)
 {
     const char *pre = "/Apps/Executables/";
@@ -1217,6 +1369,188 @@ static void hb_app_launch(void *self, const hb_app_launch_t *L)
     }
 }
 
+/* Autostart after the USB/home transition has had time to settle. Timer
+ * messages run on the global controller's UI task, just like a normal tap.
+ * Keep the timer and hook alive for the boot, including after cancellation. */
+#define AUTO_GLOBAL_GET 0x083fb524u
+#define AUTO_DELAY_MS 15000u
+#define AUTO_RETRY_MS 3000u
+static uint8_t s_auto_timer[128] __attribute__((aligned(8)));
+static msg_fn_t s_auto_global_orig;
+static void *s_auto_home;
+static int s_auto_pending = -1;
+static unsigned s_auto_retries;
+
+static int hb_auto_global_msg(void *self, void *msg)
+{
+    if (msg && *(uint32_t *)((char *)msg + MSG_FTYPE_OFF) == 16u &&
+        *(void **)((char *)msg + 8u) == (void *)s_auto_timer) {
+        int slot = s_auto_pending;
+        if (slot >= 0 && slot < g_launch_count) {
+            const hb_app_launch_t *L = &g_launch[slot];
+            char path[64];
+            hb_app_executable_path(path, L);
+            if ((L->app_kind == HB_APP_KIND_CUSTOM_SCREEN ||
+                 L->app_kind == HB_APP_KIND_GL_SURFACE) && !hb_fs_size(path)) {
+                if (s_auto_retries++ < 20u) {
+                    ((timer_set_t)(A_TIMER_SET | 1u))(s_auto_timer, (long long)AUTO_RETRY_MS);
+                    ((timer1_t)(A_TIMER_START | 1u))(s_auto_timer);
+                } else {
+                    s_auto_pending = -1;
+                    hb_trace_log("AUTONOFS", (uint32_t)slot, s_auto_retries);
+                }
+                return 1;
+            }
+            s_auto_pending = -1;
+            hb_trace_log("AUTOFIRE", (uint32_t)slot, s_auto_retries);
+            hb_app_launch(s_auto_home, L);
+        }
+        return 1;
+    }
+    return s_auto_global_orig ? s_auto_global_orig(self, msg) : 0;
+}
+
+static int hb_auto_arm(void *home, int slot)
+{
+    void *g = ((getvoid_t)(AUTO_GLOBAL_GET | 1u))();
+    uint32_t *vt;
+    if (!g) return 0;
+    vt = *(uint32_t **)g;
+    if (!vt) return 0;
+    s_auto_global_orig = (msg_fn_t)(uintptr_t)vt[MSG_SLOT_OFF / 4u];
+    vt[MSG_SLOT_OFF / 4u] = ((uint32_t)(uintptr_t)&hb_auto_global_msg) | 1u;
+    hb_icache_invalidate((uint32_t)(uintptr_t)vt, MSG_SLOT_OFF + 8u);
+    s_auto_home = home;
+    s_auto_pending = slot;
+    s_auto_retries = 0;
+    ((timer_ctor_t)(A_TIMER_CTOR | 1u))(s_auto_timer, g, 0, 0);
+    ((timer_set_t)(A_TIMER_SET | 1u))(s_auto_timer, (long long)AUTO_DELAY_MS);
+    ((timer1_t)(A_TIMER_START | 1u))(s_auto_timer);
+    hb_trace_log("AUTOARM ", (uint32_t)slot, AUTO_DELAY_MS);
+    return 1;
+}
