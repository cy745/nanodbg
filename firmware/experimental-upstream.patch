+/* ---- 蓝牙 HCI 抓包（resident 常驻，不受应用切换影响） ----
+ * 钩子只做纯内存记录：把 rx_feed 收到的字节按 [u16 len][bytes] 写进环形缓冲。
+ * 环形缓冲的地址与写指针发布到报告页的两个空闲位置，应用据此导出。
+ * 注意：钩子在蓝牙接收上下文运行，绝对不能调用文件系统。 */
+#define BT_TRANSPORT_SLOT_ADDR  0x0895c134u
+#define BT_SLOT_SEND_OFFSET     0x18u
+#define BT_SLOT_RX_OFFSET       0x20u
+#define BT_SLOT_SEND2_OFFSET    0x2Cu
+#define BT_RX_HOOK_RING_SIZE    (48u * 1024u)
+#define BTSPY_TX_FLAG           0x8000u     /* 记录头 len 的最高位 = 发送方向 */
+#define BOOT_REPORT_BTSPY_PTR_OFFSET  0x1c0u
+#define BOOT_REPORT_BTSPY_WR_OFFSET   0x1c4u
+#define BOOT_REPORT_BTSPY_LOST_OFFSET 0x1c8u
+
+typedef int (*bt_rx_feed_fn)(uint8_t *buf, uint16_t len);
+typedef int (*bt_send_fn)(int type, int opcode, int len);
+typedef int (*bt_send2_fn)(int type, int opcode, int len, const void *data);
+
+static uint8_t  s_btspy_ring[BT_RX_HOOK_RING_SIZE];
+static volatile uint32_t s_btspy_wr;
+static volatile uint32_t s_btspy_lost;
+static bt_rx_feed_fn     s_btspy_orig;
+static bt_send_fn        s_btspy_orig_send;
+static bt_send2_fn       s_btspy_orig_send2;
+static uint32_t          s_btspy_slot;
+static volatile int      s_btspy_on;
+
+/* 统一记录：flags 为 0（接收）或 BTSPY_TX_FLAG（发送） */
+static void btspy_rec(const uint8_t *p, uint32_t len, uint32_t flags)
+{
+    uint32_t need, aligned, w;
+    if (!p || !len || len > 300u)
+        return;
+    need = 2u + len;
+    aligned = (need + 3u) & ~3u;
+    w = s_btspy_wr;
+    if (w + aligned > BT_RX_HOOK_RING_SIZE)
+        w = 0;                                   /* 回绕 */
+    s_btspy_ring[w]     = (uint8_t)(len & 0xffu);
+    s_btspy_ring[w + 1] = (uint8_t)(((len >> 8) & 0x7fu) | (flags ? 0x80u : 0u));
+    for (uint32_t i = 0; i < len; i++)
+        s_btspy_ring[w + 2u + i] = p[i];
+    s_btspy_wr = w + aligned;
+}
+
+static int btspy_hook(uint8_t *buf, uint16_t len)
+{
+    if (s_btspy_on)
+        btspy_rec(buf, len, 0);
+    return s_btspy_orig ? s_btspy_orig(buf, len) : 0;
+}
+
+/* 包缓冲：*(0x0896DD18 + 0x10) = H4 报文起始地址 */
+#define BT_PKT_BUF_GLOBAL  0x0896dd18u
+
+static const uint8_t *btspy_pkt_buf(void)
+{
+    /* 结构体就在 BT_PKT_BUF_GLOBAL 处，+0x10 直接是包缓冲地址 */
+    return (const uint8_t *)(uintptr_t)(*(volatile uint32_t *)(BT_PKT_BUF_GLOBAL + 0x10u));
+}
+
+/* 发送钩子：先让原函数把包写进缓冲，再整包读取（含暂存区的参数） */
+static int btspy_send_hook(int type, int opcode, int len)
+{
+    int rc = s_btspy_orig_send ? s_btspy_orig_send(type, opcode, len) : 0x70;
+    if (s_btspy_on && rc == 0x271) {          /* 625 = 已入队 */
+        const uint8_t *pb = btspy_pkt_buf();
+        if (pb) {
+            /* 长度以包头为准：命令 [type][op][op][plen]，ACL [type][h][h][l][l] */
+            uint32_t total;
+            if (type == 2)
+                total = 5u + ((uint32_t)pb[3] | ((uint32_t)pb[4] << 8));
+            else
+                total = 4u + (uint32_t)pb[3];
+            if (total >= 4u && total <= 300u)
+                btspy_rec(pb, total, BTSPY_TX_FLAG);
+        }
+    }
+    return rc;
+}
+
+static int btspy_send2_hook(int type, int opcode, int len, const void *data)
+{
+    int rc = s_btspy_orig_send2 ? s_btspy_orig_send2(type, opcode, len, data) : 0x70;
+    if (s_btspy_on && rc == 0x271) {
+        const uint8_t *pb = btspy_pkt_buf();
+        if (pb) {
+            uint32_t total;
+            if (type == 2)
+                total = 5u + ((uint32_t)pb[3] | ((uint32_t)pb[4] << 8));
+            else
+                total = 4u + (uint32_t)pb[3];
+            if (total >= 4u && total <= 300u)
+                btspy_rec(pb, total, BTSPY_TX_FLAG);
+        }
+    }
+    return rc;
+}
+
+static void btspy_arm(void)
+{
+    if (s_btspy_on)
+        return;
+    uint32_t obj = *(volatile uint32_t *)BT_TRANSPORT_SLOT_ADDR;
+    if (!obj || obj == 0x0895c100u)     /* 蓝牙关闭时的静态桩 */
+        return;
+    uint32_t slot = obj + BT_SLOT_RX_OFFSET;
+    uint32_t cur = *(volatile uint32_t *)slot;
+    if (!cur || cur == ((uint32_t)(uintptr_t)&btspy_hook | 1u))
+        return;
+
+    /* RX */
+    s_btspy_orig = (bt_rx_feed_fn)cur;
+    s_btspy_slot = slot;
+    *(volatile uint32_t *)slot = (uint32_t)(uintptr_t)&btspy_hook | 1u;
+    hb_icache_invalidate(slot, 4);
+
+    /* TX: send */
+    {
+        uint32_t s2 = obj + BT_SLOT_SEND_OFFSET;
+        uint32_t v = *(volatile uint32_t *)s2;
+        if (v && v != ((uint32_t)(uintptr_t)&btspy_send_hook | 1u)) {
+            s_btspy_orig_send = (bt_send_fn)v;
+            *(volatile uint32_t *)s2 = (uint32_t)(uintptr_t)&btspy_send_hook | 1u;
+            hb_icache_invalidate(s2, 4);
+        }
+    }
+    /* TX: send2 */
+    {
+        uint32_t s3 = obj + BT_SLOT_SEND2_OFFSET;
+        uint32_t v = *(volatile uint32_t *)s3;
+        if (v && v != ((uint32_t)(uintptr_t)&btspy_send2_hook | 1u)) {
+            s_btspy_orig_send2 = (bt_send2_fn)v;
+            *(volatile uint32_t *)s3 = (uint32_t)(uintptr_t)&btspy_send2_hook | 1u;
+            hb_icache_invalidate(s3, 4);
+        }
+    }
+    s_btspy_on = 1;
+    /* 发布环形缓冲位置 */
+    *(volatile uint32_t *)(BOOT_REPORT_BASE + BOOT_REPORT_BTSPY_PTR_OFFSET) =
+        (uint32_t)(uintptr_t)s_btspy_ring;
+    *(volatile uint32_t *)(BOOT_REPORT_BASE + BOOT_REPORT_BTSPY_WR_OFFSET) =
+        (uint32_t)(uintptr_t)&s_btspy_wr;
+    *(volatile uint32_t *)(BOOT_REPORT_BASE + BOOT_REPORT_BTSPY_LOST_OFFSET) = 0;
+}
+
 static int hb_boot_report_live(void)
 {
     return *(volatile uint32_t *)(BOOT_REPORT_BASE + BOOT_REPORT_MAGIC_OFFSET) ==
@@ -1034,6 +1180,12 @@ static void           *s_app_arena[HB_MAX_APPS];
 static uint32_t        s_app_code_len[HB_MAX_APPS];
