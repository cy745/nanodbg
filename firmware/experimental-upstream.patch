+/* USB debugger rendezvous. The SCSI task only sets a flag; the UI task owns
+ * the capture buffer and copies the display, avoiding OS calls in SCSI context. */
+typedef struct {
+    uint32_t magic, version, capture_fn, sequence, status;
+    uint32_t pixels, width, height, app_id, app_visible;
+    uint32_t touch_fn[19], touch_sequence, touch_status;
+} hb_debug_report_t;
+static volatile hb_debug_report_t s_debug;
+static volatile uint32_t s_debug_request;
+static uint8_t s_debug_timer[128] __attribute__((aligned(8)));
+static msg_fn_t s_debug_orig;
+static uint32_t *s_debug_pixels;
+static int s_debug_installed;
+static volatile uint32_t s_debug_x, s_debug_y, s_debug_tap;
+static uint32_t s_debug_tap_phase;
+
+static void hb_debug_capture_request(void) { s_debug_request = 1; }
+static void hb_debug_touch_clear(void) { s_debug_x = s_debug_y = 0; }
+#define DEBUG_X_BIT(n) static void hb_debug_x##n(void) { s_debug_x |= 1u << n; }
+#define DEBUG_Y_BIT(n) static void hb_debug_y##n(void) { s_debug_y |= 1u << n; }
+DEBUG_X_BIT(0) DEBUG_X_BIT(1) DEBUG_X_BIT(2) DEBUG_X_BIT(3)
+DEBUG_X_BIT(4) DEBUG_X_BIT(5) DEBUG_X_BIT(6) DEBUG_X_BIT(7)
+DEBUG_Y_BIT(0) DEBUG_Y_BIT(1) DEBUG_Y_BIT(2) DEBUG_Y_BIT(3)
+DEBUG_Y_BIT(4) DEBUG_Y_BIT(5) DEBUG_Y_BIT(6) DEBUG_Y_BIT(7) DEBUG_Y_BIT(8)
+static void hb_debug_touch_commit(void) { s_debug_tap = 1; }
+
+static void hb_debug_capture(void)
+{
+    volatile uint32_t *r = (volatile uint32_t *)0x38900000u;
+    uint32_t fmt = (r[0x20/4] >> 8) & 15u, wh = r[0x30/4];
+    uint32_t w = (wh >> 16) & 511u, h = wh & 511u;
+    uint32_t span = r[0x28/4] & 4095u, sxy = r[0x2c/4];
+    uint32_t x, y, tries, sx = (sxy >> 16) & 2047u, sy = sxy & 2047u;
+    s_debug.status = 2;
+    if (!w || !h || w > 432u || h > 432u || w * h > 240u * 432u ||
+        span < w + sx || (fmt != 4u && fmt != 7u)) goto done;
+    if (!s_debug_pixels) s_debug_pixels = (uint32_t *)hb_os_alloc(240u * 432u * 4u);
+    if (!s_debug_pixels) goto done;
+    for (tries = 0; tries < 4; tries++) {
+        uint32_t base = r[0x24/4];
+        if (!base) goto done;
+        for (y = 0; y < h; y++) for (x = 0; x < w; x++) {
+            uint32_t idx = (sy + y) * span + sx + x, c;
+            if (fmt == 7u) c = ((volatile uint32_t *)(uintptr_t)base)[idx] & 0xffffffu;
+            else {
+                uint32_t v = ((volatile uint16_t *)(uintptr_t)base)[idx];
+                uint32_t rr = (v >> 11) & 31u, gg = (v >> 5) & 63u, bb = v & 31u;
+                c = ((rr * 255u / 31u) << 16) | ((gg * 255u / 63u) << 8) | (bb * 255u / 31u);
+            }
+            s_debug_pixels[y * w + x] = c;
+        }
+        if (r[0x24/4] == base) break;
+    }
+    s_debug.pixels = (uint32_t)(uintptr_t)s_debug_pixels;
+    s_debug.width = w; s_debug.height = h; s_debug.status = 1;
+done:
+    __asm__ volatile("dsb sy" : : : "memory");
+    s_debug.sequence++;
+}
+
+static int hb_debug_msg(void *self, void *msg)
+{
+    if (msg && *(uint32_t *)((char *)msg + MSG_FTYPE_OFF) == 16u &&
+        *(void **)((char *)msg + 8u) == (void *)s_debug_timer) {
+        s_debug.app_id = s_cur_app_id;
+        s_debug.app_visible = s_surface_view != 0;
+        if (s_debug_request) { s_debug_request = 0; hb_debug_capture(); }
+        if (s_debug_tap_phase) {
+            if (--s_debug_tap_phase == 0) {
+                s_shared.touch[3] = 0;
+                s_debug.touch_status = 1;
+                s_debug.touch_sequence++;
+            }
+        } else if (s_debug_tap) {
+            s_debug_tap = 0;
+            if (s_surface_view && s_debug_x < 240u && s_debug_y < 432u) {
+                s_shared.touch[1] = (int32_t)s_debug_x;
+                s_shared.touch[2] = (int32_t)s_debug_y;
+                s_shared.touch[3] = 1;
+                s_shared.touch[0] = (int32_t)TOUCH_MB_MAGIC;
+                s_debug_tap_phase = 2;
+            } else {
+                s_debug.touch_status = 2;
+                s_debug.touch_sequence++;
+            }
+        }
+        ((timer_set_t)(A_TIMER_SET | 1u))(s_debug_timer, (long long)200u);
+        ((timer1_t)(A_TIMER_START | 1u))(s_debug_timer);
+        return 1;
+    }
+    return s_debug_orig ? s_debug_orig(self, msg) : 0;
+}
+
+static void hb_debug_install(void)
+{
+    void *g; uint32_t *vt;
+    if (s_debug_installed) return;
+    g = ((getvoid_t)(AUTO_GLOBAL_GET | 1u))();
+    if (!g || !(vt = *(uint32_t **)g)) return;
+    s_debug_orig = (msg_fn_t)(uintptr_t)vt[MSG_SLOT_OFF / 4u];
+    vt[MSG_SLOT_OFF / 4u] = ((uint32_t)(uintptr_t)&hb_debug_msg) | 1u;
+    hb_icache_invalidate((uint32_t)(uintptr_t)vt, MSG_SLOT_OFF + 8u);
+    s_debug.magic = 0x4742444eu; s_debug.version = 2;
+    s_debug.capture_fn = ((uint32_t)(uintptr_t)&hb_debug_capture_request) | 1u;
+    {
+        void (*const f[])(void) = { hb_debug_touch_clear,
+            hb_debug_x0, hb_debug_x1, hb_debug_x2, hb_debug_x3,
+            hb_debug_x4, hb_debug_x5, hb_debug_x6, hb_debug_x7,
+            hb_debug_y0, hb_debug_y1, hb_debug_y2, hb_debug_y3,
+            hb_debug_y4, hb_debug_y5, hb_debug_y6, hb_debug_y7, hb_debug_y8,
+            hb_debug_touch_commit };
+        unsigned i;
+        for (i = 0; i < 19u; i++) s_debug.touch_fn[i] = ((uint32_t)(uintptr_t)f[i]) | 1u;
+    }
+    hb_boot_report(0x1d0u, (uint32_t)(uintptr_t)&s_debug);
+    s_debug_installed = 1;
+    ((timer_ctor_t)(A_TIMER_CTOR | 1u))(s_debug_timer, g, 0, 0);
+    ((timer_set_t)(A_TIMER_SET | 1u))(s_debug_timer, (long long)200u);
+    ((timer1_t)(A_TIMER_START | 1u))(s_debug_timer);
+}
